{
  "name": "mcp-tool-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server exposing validated, sandboxed tools to AI clients",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx -y @modelcontextprotocol/inspector@2.12.0 --cli node dist/index.js --method tools/list",
    "demo": "bash scripts/demo.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
